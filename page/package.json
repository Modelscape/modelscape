{
  "name": "modelscape-page",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:page && npm run build:builder",
    "build:page": "esbuild src/index.ts --bundle --format=iife --minify --loader:.css=text --outfile=../modelscape/static/page.js",
    "build:builder": "esbuild src/builder.ts --bundle --format=esm --minify --loader:.css=text --outfile=../modelscape/static/builder.js",
    "watch": "npm run build:page -- --watch",
    "check": "tsc && eslint . && prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
